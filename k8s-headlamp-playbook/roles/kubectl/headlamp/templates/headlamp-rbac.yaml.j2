apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ headlamp_admin_sa }}
  namespace: {{ headlamp_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ headlamp_admin_sa }}
subjects:
  - kind: ServiceAccount
    name: {{ headlamp_admin_sa }}
    namespace: {{ headlamp_namespace }}
roleRef:
  kind: ClusterRole
  name: {{ headlamp_admin_clusterrole }}
  apiGroup: rbac.authorization.k8s.io
{% if headlamp_create_long_term_token %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ headlamp_admin_sa }}-token
  namespace: {{ headlamp_namespace }}
  annotations:
    kubernetes.io/service-account.name: {{ headlamp_admin_sa }}
type: kubernetes.io/service-account-token
{% endif %}
